options:
  parameters:
    author: Maria
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: "Dete\xE7\xE3o e alinhamento com a refer\xEAncia gerada no loopback"
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: WEEK5
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: "Week 5 - Sinal de refer\xEAncia"
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [24, 16.0]
    rotation: 0
    state: enabled

blocks:
- name: nwin
  id: variable
  parameters:
    comment: Comparar 16, 48 e 96 amostras
    value: '48'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [392, 40.0]
    rotation: 0
    state: enabled
- name: playback_rate
  id: variable
  parameters:
    comment: Amostras por segundo reproduzidas no computador
